# ============================================================================
# AVIRATO API CREDENTIALS
# ============================================================================
# Credenciales para la API de Avirato (opcional, para autocompletar login)
VITE_AVIRATO_DEFAULT_EMAIL=
VITE_AVIRATO_DEFAULT_PASSWORD=

# ============================================================================
# LAST.APP API CREDENTIALS
# ============================================================================
# Token de autenticación de Last.app (Bearer Token)
# Obtén tu token desde: https://developers.last.app
VITE_LASTAPP_TOKEN=

# ID de la organización de Last.app
VITE_LASTAPP_ORGANIZATION_ID=

# ID de la ubicación/local de Last.app
VITE_LASTAPP_LOCATION_ID=

# ============================================================================
# SUPABASE DATABASE CREDENTIALS
# ============================================================================
# URL de tu proyecto Supabase
# Obtén estos valores desde: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=

# Clave anónima (anon/public key) de Supabase
# Esta clave es segura para usar en el frontend
VITE_SUPABASE_ANON_KEY=

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================
# IMPORTANTE:
# 1. NO compartas estos valores públicamente
# 2. NO subas este archivo al repositorio (usa .env.local)
# 3. Para producción, configura estas variables en tu servidor de deployment
# 4. NUNCA incluyas tokens reales en commits de git
# 5. La clave SUPABASE_ANON_KEY es segura para el frontend cuando se usa con RLS
